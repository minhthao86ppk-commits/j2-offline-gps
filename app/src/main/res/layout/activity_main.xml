<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- KHUNG BẢN ĐỒ TOÀN MÀN HÌNH -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <org.osmdroid.views.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Nút mở Menu tối giản góc trái -->
        <Button
            android:id="@+id/btnOpenMenu"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:text="MENU"
            android:textStyle="bold"
            android:textSize="12sp"
            android:textColor="#FFFFFF"
            android:background="#D32F2F"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:layout_margin="12dp" />

        <!-- Bảng trạng thái gọn góc phải -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="12dp"
            android:background="#CC000000"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvQuickStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="XE 01 (CHỈ HUY) - CHỜ LỆNH"
                android:textColor="#00FF66"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Đã ghi: 0 điểm | Cự ly: --"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

    </RelativeLayout>

    <!-- MENU TRƯỢT PHẲNG TỐI GIẢN (FLAT LIST MENU) -->
    <ScrollView
        android:layout_width="285dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#FFFFFF"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- PHẦN HEADER ĐỎ TRẦM (TƯƠNG TỰ ẢNH MẪU) -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#C62828"
                android:paddingTop="24dp"
                android:paddingBottom="16dp"
                android:paddingStart="20dp"
                android:paddingEnd="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CHỈ HUY TÁC CHIẾN"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="J2 Offline Tracker • LoRa 923"
                        android:textColor="#FFCDD2"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- Nút Đóng 'X' góc phải Header -->
                <Button
                    android:id="@+id/btnCloseMenu"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:text="✕"
                    android:textSize="14sp"
                    android:textColor="#FFFFFF"
                    android:background="?android:attr/selectableItemBackground" />
            </RelativeLayout>

            <!-- ========================================= -->
            <!-- PHÂN ĐOÀN 1: VỆT HÀNH TRÌNH & CỜ MỐC     -->
            <!-- ========================================= -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="HÀNH TRÌNH &amp; MỐC CỜ"
                android:textColor="#9E9E9E"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="20dp"
                android:paddingTop="14dp"
                android:paddingBottom="4dp" />

            <Button
                android:id="@+id/btnStartRecord"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Bắt đầu ghi vệt"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#263238"
                android:background="?android:attr/selectableItemBackground" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F0F0F0"
                android:layout_marginStart="20dp" />

            <Button
                android:id="@+id/btnStopRecord"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Dừng và xuất file GPX"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#263238"
                android:background="?android:attr/selectableItemBackground" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F0F0F0"
                android:layout_marginStart="20dp" />

            <Button
                android:id="@+id/btnFlagYellow"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Cắm cờ vàng (Ghi nhớ)"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#263238"
                android:background="?android:attr/selectableItemBackground" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F0F0F0"
                android:layout_marginStart="20dp" />

            <Button
                android:id="@+id/btnFlagPurple"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Cắm cờ tím (Kiểm tra)"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#263238"
                android:background="?android:attr/selectableItemBackground" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F0F0F0"
                android:layout_marginStart="20dp" />

            <Button
                android:id="@+id/btnClearFlags"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Xóa toàn bộ cờ mốc"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#78909C"
                android:background="?android:attr/selectableItemBackground" />

            <!-- ========================================= -->
            <!-- PHÂN ĐOÀN 2: DẪN ĐƯỜNG GPX               -->
            <!-- ========================================= -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="DẪN ĐƯỜNG LỘ TRÌNH"
                android:textColor="#9E9E9E"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="4dp" />

            <Button
                android:id="@+id/btnLoadFollowGpx"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Nạp lộ trình GPX dẫn đường"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#263238"
                android:background="?android:attr/selectableItemBackground" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F0F0F0"
                android:layout_marginStart="20dp" />

            <Button
                android:id="@+id/btnClearRoute"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Hủy lộ trình dẫn đường"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#78909C"
                android:background="?android:attr/selectableItemBackground" />

            <!-- ========================================= -->
            <!-- PHÂN ĐOÀN 3: ĐIỀU HÀNH LORA              -->
            <!-- ========================================= -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="MỆNH LỆNH TÁC CHIẾN (LORA)"
                android:textColor="#9E9E9E"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingBottom="4dp" />

            <Button
                android:id="@+id/btnCmdStop"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Dừng xe"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#263238"
                android:background="?android:attr/selectableItemBackground" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F0F0F0"
                android:layout_marginStart="20dp" />

            <Button
                android:id="@+id/btnCmdResume"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Tiếp tục hành quân"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#263238"
                android:background="?android:attr/selectableItemBackground" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F0F0F0"
                android:layout_marginStart="20dp" />

            <Button
                android:id="@+id/btnCmdSpeedUp"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Tăng tốc"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#263238"
                android:background="?android:attr/selectableItemBackground" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F0F0F0"
                android:layout_marginStart="20dp" />

            <Button
                android:id="@+id/btnCmdSlowDown"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Giảm tốc"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#263238"
                android:background="?android:attr/selectableItemBackground" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F0F0F0"
                android:layout_marginStart="20dp" />

            <Button
                android:id="@+id/btnCmdCloseSpacing"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Thu cự ly"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#263238"
                android:background="?android:attr/selectableItemBackground" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F0F0F0"
                android:layout_marginStart="20dp" />

            <Button
                android:id="@+id/btnCmdOpenSpacing"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Dãn cự ly"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                android:textSize="13sp"
                android:textAllCaps="false"
                android:textColor="#263238"
                android:background="?android:attr/selectableItemBackground" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#F0F0F0"
                android:layout_marginStart="20dp" />

            <Button
                android:id="@+id/btnCmdEmergency"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="Tình huống khẩn cấp"
                android:gravity="start|center_vertical"
                android:paddingStart="20dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:textColor="#C62828"
                android:background="?android:attr/selectableItemBackground" />

            <View
                android:layout_width="match_parent"
                android:layout_height="16dp" />

        </LinearLayout>
    </ScrollView>

</androidx.drawerlayout.widget.DrawerLayout>
