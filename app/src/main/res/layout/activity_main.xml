<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. MÀN HÌNH CHÍNH: BẢN ĐỒ TOÀN PHẦN 100% -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Khung bản đồ Osmdroid tràn viền -->
        <org.osmdroid.views.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Nút mở Menu dã chiến thu nhỏ ở góc trên bên trái -->
        <Button
            android:id="@+id/btnOpenMenu"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="☰ MENU"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#CC222222"
            android:layout_margin="12dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <!-- Ô trạng thái mini mờ ở góc trên bên phải -->
        <TextView
            android:id="@+id/tvQuickStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="#CC000000"
            android:padding="6dp"
            android:text="Chế độ: Chờ lệnh"
            android:textColor="#00FF66"
            android:textSize="12sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- 2. MENU TRƯỢT (THÒ RA / THỤT VÀO TỪ CẠNH TRÁI) -->
    <ScrollView
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#F8F9FA"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ĐIỀU KHIỂN TÁC CHIẾN"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1A237E"
                android:paddingBottom="12dp" />

            <!-- PHÂN ĐOÀN 1: CHẾ ĐỘ GHI LỘ TRÌNH -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. CHẾ ĐỘ: GHI LỘ TRÌNH"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#D32F2F"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Đã ghi: 0 điểm\nTọa độ: 0.0, 0.0"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnStartRecord"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="BẮT ĐẦU GHI VỆT"
                android:textSize="13sp"
                android:background="#2E7D32"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btnStopRecord"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="DỪNG &amp; XUẤT GPX"
                android:textSize="13sp"
                android:enabled="false"
                android:layout_marginBottom="16dp" />

            <!-- ĐƯỜNG PHÂN CÁCH NỘI DUNG -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginBottom="16dp" />

            <!-- PHÂN ĐOÀN 2: CHẾ ĐỘ ĐI THEO LỘ TRÌNH -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. CHẾ ĐỘ: ĐI THEO LỘ TRÌNH"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#E65100" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="(Chỉ hiện lộ trình &amp; vị trí chấm xanh, không ghi đè vệt để chống rối mắt)"
                android:textSize="11sp"
                android:textColor="#666666"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btnLoadFollowGpx"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="NẠP FILE GPX DẪN ĐƯỜNG"
                android:textSize="13sp"
                android:background="#EF6C00"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="6dp" />

            <Button
                android:id="@+id/btnClearRoute"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="XÓA LỘ TRÌNH DẪN ĐƯỜNG"
                android:textSize="13sp"
                android:layout_marginBottom="24dp" />

            <!-- NÚT ĐÓNG MENU THỦ CÔNG -->
            <Button
                android:id="@+id/btnCloseMenu"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="ĐÓNG MENU (XEM BẢN ĐỒ)"
                android:textSize="12sp"
                android:background="#E0E0E0" />
        </LinearLayout>
    </ScrollView>

</androidx.drawerlayout.widget.DrawerLayout>
