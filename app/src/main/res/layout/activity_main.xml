<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1. MÀN HÌNH CHÍNH: BẢN ĐỒ TOÀN MÀN HÌNH -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <org.osmdroid.views.MapView
            android:id="@+id/mapView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <!-- Nút mở Menu góc trên bên trái -->
        <Button
            android:id="@+id/btnOpenMenu"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:text="☰ MENU"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="#CC222222"
            android:layout_margin="12dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp" />

        <!-- Nhãn trạng thái góc trên bên phải -->
        <TextView
            android:id="@+id/tvQuickStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="12dp"
            android:background="#CC000000"
            android:padding="6dp"
            android:text="Chế độ: Chờ lệnh"
            android:textColor="#00FF66"
            android:textSize="12sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- 2. MENU TRƯỢT CHỈ HUY TÁC CHIẾN -->
    <ScrollView
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#F8F9FA"
        android:padding="14dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="ĐIỀU HÀNH HÀNH QUÂN"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1A237E"
                android:paddingBottom="10dp" />

            <!-- PHÂN ĐOÀN 1: GHI VỆT DI CHUYỂN -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1. GHI VỆT DI CHUYỂN"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#2E7D32" />

            <TextView
                android:id="@+id/tvStats"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Đã ghi: 0 điểm\nTọa độ: 0.0, 0.0"
                android:textSize="11sp"
                android:layout_marginBottom="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnStartRecord"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="BẮT ĐẦU"
                    android:textSize="12sp"
                    android:background="#2E7D32"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="3dp" />

                <Button
                    android:id="@+id/btnStopRecord"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="DỪNG &amp; XUẤT"
                    android:textSize="12sp"
                    android:enabled="false"
                    android:layout_marginStart="3dp" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp" />

            <!-- PHÂN ĐOÀN 2: DẪN ĐƯỜNG THEO FILE GPX -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="2. DẪN ĐƯỜNG THEO FILE GPX"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#E65100" />

            <Button
                android:id="@+id/btnLoadFollowGpx"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:text="NẠP GPX DẪN ĐƯỜNG"
                android:textSize="12sp"
                android:background="#EF6C00"
                android:textColor="#FFFFFF"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="4dp" />

            <Button
                android:id="@+id/btnClearRoute"
                android:layout_width="match_parent"
                android:layout_height="36dp"
                android:text="XÓA LỘ TRÌNH DẪN ĐƯỜNG"
                android:textSize="11sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#CCCCCC"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp" />

            <!-- PHÂN ĐOÀN 3: BẢNG LỆNH CHỈ HUY NHANH QUA LORA -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="3. LỆNH ĐIỀU HÀNH ĐOÀN XE"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#C62828" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="(Chạm để phát tín hiệu vô tuyến tức thời)"
                android:textSize="10sp"
                android:textColor="#777777"
                android:layout_marginBottom="8dp" />

            <!-- 1. DỪNG XE -->
            <Button
                android:id="@+id/btnCmdStop"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="🛑 DỪNG XE"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="#D32F2F"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="4dp" />

            <!-- 2. TIẾP TỤC HÀNH QUÂN -->
            <Button
                android:id="@+id/btnCmdResume"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="▶️ TIẾP TỤC HÀNH QUÂN"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="#2E7D32"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="4dp" />

            <!-- CỤM TỐC ĐỘ: TĂNG TỐC / GIẢM TỐC -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <!-- 3. TĂNG TỐC -->
                <Button
                    android:id="@+id/btnCmdSpeedUp"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:text="⚡ TĂNG TỐC"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="#1976D2"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="2dp" />

                <!-- 4. GIẢM TỐC -->
                <Button
                    android:id="@+id/btnCmdSlowDown"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:text="⏳ GIẢM TỐC"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="#F57C00"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="2dp" />
            </LinearLayout>

            <!-- CỤM CỰ LY: THU CỰ LY / DÃN CỰ LY -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <!-- 5. THU CỰ LY -->
                <Button
                    android:id="@+id/btnCmdCloseSpacing"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:text="➡️⬅️ THU CỰ LY"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="#0288D1"
                    android:textColor="#FFFFFF"
                    android:layout_marginEnd="2dp" />

                <!-- 6. DÃN CỰ LY -->
                <Button
                    android:id="@+id/btnCmdOpenSpacing"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:text="⬅️➡️ DÃN CỰ LY"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:background="#7B1FA2"
                    android:textColor="#FFFFFF"
                    android:layout_marginStart="2dp" />
            </LinearLayout>

            <!-- 7. TÌNH HUỐNG KHẨN CẤP (SOS) -->
            <Button
                android:id="@+id/btnCmdEmergency"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="🚨 TÌNH HUỐNG KHẨN CẤP"
                android:textSize="12sp"
                android:textStyle="bold"
                android:background="#212121"
                android:textColor="#FF5252"
                android:layout_marginTop="2dp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/btnCloseMenu"
                android:layout_width="match_parent"
                android:layout_height="38dp"
                android:text="ĐÓNG MENU"
                android:textSize="12sp"
                android:background="#E0E0E0" />
        </LinearLayout>
    </ScrollView>

</androidx.drawerlayout.widget.DrawerLayout>
